{
  "manifest_version": 3,
  "name": "Minnoware — Shopping Mission Control",
  "version": "0.1.0",
  "description": "Track parallel shopping decisions across multiple projects. Save products from any page, monitor prices, and manage your pipeline.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Minnoware — Shopping Mission Control",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "src/store.js", "src/data.js", "src/app.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

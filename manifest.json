{
  "manifest_version": 3,
  "name": "Shopping Mission Control",
  "version": "0.1.0",
  "description": "Track parallel shopping decisions across projects",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopping Mission Control"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "src/store.js", "src/data.js", "src/app.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
